# Cloudflare R2 photo storage. Copy to .env.local and fill in.
# Vehicle photos and the showroom logo are stored in Cloudflare R2.
NEXT_PUBLIC_IMAGE_STORAGE=r2

# R2 → Manage API tokens → Create token with "Object Read & Write" on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=used-car-erp-m-garage

# Optional: public bucket domain (e.g. https://photos.example.com). Unset = private bucket with signed URLs.
R2_PUBLIC_URL=
# Storage allowance shown in Settings → Photo storage (GB). R2's free tier is 10 GB.
R2_STORAGE_QUOTA_GB=10

# Supabase (database and sign-in). Project Settings → API Keys.
# Leave empty until the project exists; the app keeps using this browser's storage meanwhile.
NEXT_PUBLIC_SUPABASE_URL=https://fzlxbmbvhixdfjtiglvc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row-level security; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
